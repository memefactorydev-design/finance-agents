# ---------------------------------------------------------------------------
# Finance Agents — environment. Copy to .env.local (never commit .env.local).
# Everything below can also be entered in the setup wizard (http://localhost:3000/setup)
# and is then stored encrypted in the finance store; an env var wins over the wizard.
# ---------------------------------------------------------------------------

# REQUIRED. 32+ random bytes, base64. Encrypts stored tokens and signs sessions.
#   openssl rand -base64 32
APP_SECRET=

# Where the finance store lives. Default: ./data/store.json (single-user, local).
# For a hosted deployment set a Postgres URL (Supabase, Neon, RDS…) instead.
# DATABASE_URL=postgres://user:pass@host:5432/finance

# Public URL of this app (used for OAuth redirects and links in briefs).
APP_URL=http://localhost:3000

# Protects the cron endpoint (Vercel Cron sends it automatically; the local scheduler reads it).
CRON_SECRET=

# --- AI (invoice extraction, acknowledgement extraction) --------------------
ANTHROPIC_API_KEY=
# Optional: use OpenAI instead (FINANCE_EXTRACTOR=openai)
# OPENAI_API_KEY=
# FINANCE_EXTRACTOR=anthropic
# FINANCE_EXTRACT_MODEL=claude-sonnet-5

# --- QuickBooks Online: your own Intuit app (option A) ---------------------
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REDIRECT_URI=http://localhost:3000/api/oauth/qbo/callback
# QBO_ENVIRONMENT=production   # or sandbox
# QBO_REALM_ID=                 # optional: pin a company; otherwise bound on first consent
# --- QuickBooks Online through Composio (option B) --------------------------
# COMPOSIO_API_KEY=
# COMPOSIO_QBO_CONNECTED_ACCOUNT_ID=
# Posting gate: until true every QuickBooks write is a dry run that stores the exact payload.
FINANCE_POST_BILLS=false

# --- Mailboxes: Microsoft 365 (app-only) or IMAP ---------------------------
# M365_TENANT_ID=
# M365_CLIENT_ID=
# M365_CLIENT_SECRET=
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# FINANCE_INTAKE_MAILBOXES=accounts@example.com,info@example.com
# FINANCE_ORDERS_MAILBOXES=orders@example.com
# FINANCE_ACCOUNTS_MAILBOX=accounts@example.com

# --- CRM connector ---------------------------------------------------------
# CRM_MODE=manual | rest | webhook | mcp
# CRM_REST_PROJECTS_URL=https://your-crm.example.com/api/projects
# CRM_REST_TOKEN=
# CRM_WEBHOOK_SECRET=
# CRM_MCP_URL=https://your-crm.example.com/api/mcp
# CRM_MCP_TOKEN=

# --- Notifications (optional) ---------------------------------------------
# SLACK_WEBHOOK_URL=
